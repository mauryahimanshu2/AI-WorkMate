NODE_ENV=development
PORT=5000
MONGODB_URI=
CORS_ORIGIN=

JWT_SECRET=replace-with-a-long-random-access-token-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-token-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=replace-with-a-strong-admin-password

AI_PROVIDER=gemini
GEMINI_API_KEY=

AI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_MS=60000
AI_RETRY_ATTEMPTS=3
AI_MAX_INPUT_LENGTH=5000
AI_MAX_OUTPUT_TOKENS=4000
AI_RATE_LIMIT=10
AI_INPUT_COST_PER_1M_TOKENS=0
AI_OUTPUT_COST_PER_1M_TOKENS=0

