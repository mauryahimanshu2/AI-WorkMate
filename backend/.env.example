NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ai-workmate
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

JWT_SECRET=replace-with-a-long-random-access-token-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-token-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

ADMIN_NAME=Admin
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=gemini-flash-latest
AI_TIMEOUT_MS=60000
AI_MAX_INPUT_LENGTH=5000
AI_MAX_OUTPUT_TOKENS=4000
AI_RATE_LIMIT=10
AI_INPUT_COST_PER_1M_TOKENS=0
AI_OUTPUT_COST_PER_1M_TOKENS=0

